{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LearnLive",
  "version": "0.2.0",
  "identifier": "dev.eknowles.learnlive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LearnLive",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 480,
        "alwaysOnTop": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "appimage"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist"
    }
  }
}
